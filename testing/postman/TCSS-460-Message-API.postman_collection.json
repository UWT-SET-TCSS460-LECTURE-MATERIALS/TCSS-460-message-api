			"item": [
				{
					"name": "GET Health Status",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"// Educational: Testing basic health endpoint",
									"pm.test('Status code is 200', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test('Response has correct structure', function () {",
									"    const responseJson = pm.response.json();",
									"    pm.expect(responseJson).to.have.property('status');",
									"    pm.expect(responseJson).to.have.property('timestamp');",
									"    pm.expect(responseJson.status).to.eql('OK');",
									"});",
									"",
									"pm.test('Response time is acceptable', function () {",
									"    pm.expect(pm.response.responseTime).to.be.below(500);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/health",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"health"
							]
						},
						"description": "Health check endpoint to verify API availability and basic functionality."
					},
					"response": []
				}
			],
			"description": "Basic health monitoring endpoints"
		},
