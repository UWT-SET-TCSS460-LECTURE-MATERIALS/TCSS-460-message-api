              "path": ["api-key"]
            }
          }
        },
        {
          "name": "Generate API Key",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Extra delay for API key generation to ensure DB commit",
                  "const extraDelay = 200;",
                  "setTimeout(function(){}, extraDelay);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Response has success flag\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "});",
                  "",
                  "pm.test(\"API key is returned\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data.api_key).to.exist;",
                  "    pm.expect(jsonData.data.api_key).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i);",
                  "});",
                  "",
                  "pm.test(\"Save API key to environment\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.environment.set(\"apiKey\", jsonData.data.api_key);",
                  "    console.log(\"API Key saved: \" + jsonData.data.api_key);",
                  "});"
                ]
              }
            }
          ],
