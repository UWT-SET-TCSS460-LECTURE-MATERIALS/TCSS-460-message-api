                  "    pm.expect(jsonData.data.name).to.exist;",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "console.log(`✅ Created: ${jsonData.data.formatted}`);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{lastCreatedName}}\",\n  \"message\": \"{{$randomPhrase}}\",\n  \"priority\": {{randomPriority}}\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/protected/message",
              "host": ["{{baseUrl}}"],
              "path": ["protected", "message"]
            }
          }
        },
        {
          "name": "Get All Protected Messages",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Messages retrieved with valid API key\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "    pm.expect(jsonData.data.entries).to.be.an('array');",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "console.log(`📊 Total protected messages: ${jsonData.data.totalCount}`);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/protected/message/all",
              "host": ["{{baseUrl}}"],
              "path": ["protected", "message", "all"]
            }
          }
        },
        {
          "name": "Update Protected Message",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const lastName = pm.collectionVariables.get('lastCreatedName');",
                  "",
                  "if (!lastName) {",
                  "    console.log('⚠️ No lastCreatedName found. Run a CREATE request first.');",
                  "}",
                  "",
                  "console.log(`🔄 Updating protected message for: ${lastName}`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 or 404\", function () {",
                  "    pm.expect([200, 404]).to.include(pm.response.code);",
                  "});",
                  "",
                  "if (pm.response.code === 200) {",
                  "    pm.test(\"Message updated successfully\", function () {",
                  "        var jsonData = pm.response.json();",
                  "        pm.expect(jsonData.success).to.be.true;",
                  "    });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{lastCreatedName}}\",\n  \"message\": \"UPDATED PROTECTED: {{$randomPhrase}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/protected/message",
              "host": ["{{baseUrl}}"],
              "path": ["protected", "message"]
            }
          }
        },
        {
          "name": "Delete Protected Message",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const lastName = pm.collectionVariables.get('lastCreatedName');",
                  "",
                  "if (!lastName) {",
                  "    console.log('⚠️ No lastCreatedName found. Run a CREATE request first.');",
                  "}",
                  "",
                  "console.log(`🗑️ Deleting protected message for: ${lastName}`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 or 404\", function () {",
                  "    pm.expect([200, 404]).to.include(pm.response.code);",
                  "});",
                  "",
                  "if (pm.response.code === 200) {",
                  "    pm.test(\"Message deleted successfully\", function () {",
                  "        var jsonData = pm.response.json();",
                  "        pm.expect(jsonData.success).to.be.true;",
                  "    });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/protected/message/{{lastCreatedName}}",
              "host": ["{{baseUrl}}"],
              "path": ["protected", "message", "{{lastCreatedName}}"]
            }
          }
        }
      ]
    }
  ]
