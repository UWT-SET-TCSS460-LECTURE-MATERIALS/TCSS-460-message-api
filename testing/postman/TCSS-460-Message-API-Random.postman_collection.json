    {
      "name": "2. Quick DB Population",
      "description": "Use these requests to quickly populate the database with random test data. Perfect for running multiple iterations in Collection Runner.",
      "item": [
        {
          "name": "Create Random Message",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Generate random priority (1, 2, or 3)",
                  "function getRandomPriority() {",
                  "    return Math.floor(Math.random() * 3) + 1;",
                  "}",
                  "",
                  "// Set random priority for this request",
                  "const priority = getRandomPriority();",
                  "pm.collectionVariables.set('randomPriority', priority);",
                  "",
                  "// Generate a unique name using timestamp to avoid duplicates",
                  "const randomName = pm.variables.replaceIn('{{$randomFirstName}}') + '_' + Date.now();",
                  "pm.collectionVariables.set('lastCreatedName', randomName);",
                  "",
                  "console.log(`🎲 Generating random message: ${randomName} (Priority: ${priority})`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Message created successfully\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "    pm.expect(jsonData.data.name).to.exist;",
                  "    pm.expect(jsonData.data.priority).to.be.within(1, 3);",
                  "});",
                  "",
                  "pm.test(\"Random data is valid\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data.name).to.be.a('string');",
                  "    pm.expect(jsonData.data.message).to.be.a('string');",
                  "    pm.expect(jsonData.data.message.length).to.be.above(0);",
                  "});",
                  "",
                  "// Log the created message for visibility",
                  "var jsonData = pm.response.json();",
                  "console.log(`✅ Created: ${jsonData.data.formatted}`);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{lastCreatedName}}\",\n  \"message\": \"{{$randomPhrase}}\",\n  \"priority\": {{randomPriority}}\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/message",
              "host": ["{{baseUrl}}"],
              "path": ["message"]
            }
          }
        },
